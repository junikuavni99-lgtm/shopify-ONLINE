<section class="hero" data-reveal>
  <div class="container grid">
    <div>
      <span class="chip">Luxury pet care house</span>
      <h1 class="display">Pawfect care for modern pets.</h1>
      <p class="kicker">
        An immersive boutique experience for grooming, nutrition, daycare, and elevated everyday rituals for your companion.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href="#services">Explore services</a>
        <a class="btn btn-outline" href="#reviews">Read reviews</a>
      </div>
    </div>
    <div class="hero-card" aria-label="Luxury pet brand visual">
      <div class="orb orb-one"></div>
      <div class="orb orb-two"></div>
      <div class="paw-scene">
        <span>🐶</span>
        <span>🐾</span>
        <span>🦴</span>
        <span>💛</span>
      </div>
      <div class="badge b1">Spa-grade grooming</div>
      <div class="badge b2">Nutrition concierge</div>
    </div>
  </div>
</section>

<div class="marquee" aria-label="Pawfect highlights">
  <div class="marquee-track">
    <span>Luxury grooming <em>•</em> Calm daycare <em>•</em> Tailored nutrition <em>•</em> Premium pet rituals <em>•</em></span>
    <span>Luxury grooming <em>•</em> Calm daycare <em>•</em> Tailored nutrition <em>•</em> Premium pet rituals <em>•</em></span>
  </div>
</div>

<section id="services" class="slab" data-reveal>
  <div class="container">
    <div class="section-head">
      <div>
        <span class="chip">Signature services</span>
        <h2>Everything feels considered.</h2>
      </div>
      <p>Four premium care pillars designed to make every visit beautiful, safe, calm, and memorable.</p>
    </div>
    <div class="bento">
      <article class="bento-card c1" data-tilt>
        <h3>Grooming Atelier</h3>
        <p>Coat-specific wash rituals, gentle drying, finishing trims, fragrance mist, and soft-brush styling.</p>
      </article>
      <article class="bento-card c2" data-tilt>
        <h3>Nutrition Concierge</h3>
        <p>Balanced meal plans, treat guidance, and personalized wellness notes for everyday care.</p>
      </article>
      <article class="bento-card c3" data-tilt>
        <h3>Daycare Club</h3>
        <p>Small-group enrichment, supervised rest, sensory play, and calm handoff routines.</p>
      </article>
      <article class="bento-card c4" data-tilt>
        <h3>Luxury Toy Edit</h3>
        <p>Curated enrichment objects, plush favorites, chew-safe textures, and seasonal gift sets.</p>
      </article>
      <article class="bento-card c5" data-tilt>
        <h3>Private Care</h3>
        <p>For puppies, seniors, nervous pets, and companions who prefer extra quiet.</p>
      </article>
    </div>
  </div>
</section>

<section id="story" class="story slab" data-reveal>
  <div class="container story-grid">
    <div>
      <span class="chip">The Pawfect way</span>
      <h2 class="display">Soft hands. Smart routines. Beautiful outcomes.</h2>
    </div>
    <p>
      We built Pawfect like a members-only hospitality studio for pets: warm arrival, careful assessment, relaxing care, and polished finishing touches.
    </p>
  </div>
</section>

<section id="reviews" class="testimonials slab" data-reveal>
  <div class="container">
    <div class="section-head">
      <div>
        <span class="chip">Loved by pets</span>
        <h2>Owners notice the difference.</h2>
      </div>
    </div>
    <div class="t-grid">
      <article class="t-card">
        <div class="stars">★★★★★</div>
        <blockquote>“Our dog comes home calm, glossy, and happy every single time.”</blockquote>
        <div class="who"><span class="avatar"></span><span>Maya with Bruno</span></div>
      </article>
      <article class="t-card">
        <div class="stars">★★★★★</div>
        <blockquote>“The grooming feels luxury, but the team is what makes it special.”</blockquote>
        <div class="who"><span class="avatar"></span><span>Arta with Luna</span></div>
      </article>
      <article class="t-card">
        <div class="stars">★★★★★</div>
        <blockquote>“Finally a pet brand that looks premium and actually cares.”</blockquote>
        <div class="who"><span class="avatar"></span><span>Dion with Milo</span></div>
      </article>
    </div>
  </div>
</section>

