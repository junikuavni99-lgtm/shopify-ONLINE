<section class="hero" data-reveal>
  <div class="container grid">
    <div>
      <span class="chip">Pawfect is ready</span>
      <h1 class="display">Your luxury pet website is live.</h1>
      <p class="kicker">
        This theme now includes a real homepage template. If Shopify opens this page in the editor, click Home or preview the storefront root.
      </p>
      <div class="cta-row">
        <a href="{{ routes.root_url }}" class="btn btn-primary">Open home</a>
        <a href="{{ routes.root_url }}#services" class="btn btn-outline">View services</a>
      </div>
    </div>
    <div class="hero-card" aria-label="Pawfect visual">
      <div class="orb orb-one"></div>
      <div class="orb orb-two"></div>
      <div class="paw-scene">
        <span>🐶</span>
        <span>🐾</span>
        <span>🦴</span>
        <span>💛</span>
      </div>
      <div class="badge b1">Theme installed</div>
      <div class="badge b2">Homepage included</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Friendly 404"
}
{% endschema %}
