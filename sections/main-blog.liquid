<section class="slab">
  <div class="container">
    <h1 class="display" style="font-size:clamp(2rem,5vw,4rem)">{{ blog.title }}</h1>
    <div class="products" style="margin-top:2rem">
      {%- for article in blog.articles -%}
        <a class="product-card" href="{{ article.url }}">
          {%- if article.image -%}<div class="media">{{ article.image | image_url: width: 600 | image_tag: alt: article.title }}</div>{%- endif -%}
          <div class="body">
            <h3>{{ article.title }}</h3>
            <p style="color:var(--muted);font-size:.9rem;margin:.25rem 0 0">{{ article.published_at | date: '%b %d, %Y' }}</p>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}{ "name": "Blog" }{% endschema %}
